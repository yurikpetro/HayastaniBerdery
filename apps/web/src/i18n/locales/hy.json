  "about": {
    "eyebrow": "Նախագծի մասին",
    "title": "Հայաստանի բերդերի կենդանի քարտեզ",
    "intro": "HayBerd-ը մեկ տեղում հավաքում է բերդեր, ամրություններ և պատմական վայրեր՝ հայտնի հուշարձաններից մինչև այն վայրերը, որոնք հիմնականում ճանաչում են տեղացիները։",
    "sideNote": "Մենք պահպանում ենք կոորդինատները, պատմական համատեքստը, լուսանկարները, երթուղիները և աղբյուրները, որպեսզի ժառանգության ուսումնասիրությունը լինի ավելի հեշտ և պատասխանատու։",
    "mapCta": "Բացել քարտեզը",
    "submitCta": "Առաջարկել բերդ",
    "cardMapTitle": "Քարտեզ և երթուղիներ",
    "cardMapText": "Յուրաքանչյուր կետ կապված է տեղանքի հետ, որպեսզի տեսանելի լինեն դիրքը, մոտակա բնակավայրերը և հասանելիությունը։",
    "cardSourcesTitle": "Աղբյուրներ",
    "cardSourcesText": "Նյութերը ներկայացվում են հղումներով, նկարագրություններով և հավաստիության նշումներով, ոչ միայն գեղեցիկ լուսանկարներով։",
    "cardCommunityTitle": "Համայնքի մասնակցություն",
    "cardCommunityText": "Օգտատերերը կարող են առաջարկել նոր վայրեր և ճշգրտումներ, իսկ ադմինները ստուգում են տվյալները հրապարակումից առաջ։"
  },
  "rules": {
    "eyebrow": "Մոդերացիայի կանոններ",
    "title": "Ինչպես ենք ստուգում և հրապարակում նյութերը",
    "intro": "Նախագիծը հավաքում է պատմական տվյալներ, տեղական վկայություններ և դաշտային դիտարկումներ։ Որպեսզի քարտեզը մնա օգտակար, յուրաքանչյուր լրացում ստուգվում է և ստանում հստակ նշումներ։",
    "evidenceTitle": "Հաստատման մակարդակ",
