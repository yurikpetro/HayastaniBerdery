# Скопируйте в apps/web/.env — только переменные с префиксом VITE_ попадают во фронтенд.

# Google Maps JavaScript API (слои Google в переключателе карты)
# https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=

# API-ключ JavaScript API и HTTP Геокодера Яндекс.Карт (слои Яндекс)
# https://developer.tech.yandex.ru/
VITE_YANDEX_MAPS_API_KEY=
